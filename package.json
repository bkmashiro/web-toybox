{
  "name": "web-toybox-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev": "vite --config apps/toybox/vite.config.js",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "build:packages": "pnpm --filter './packages/*' --workspace-concurrency=1 run build",
    "build:site": "vite build --config apps/toybox/vite.config.js",
    "build": "pnpm build:packages && pnpm build:site",
    "size": "node scripts/size-check.mjs",
    "clean": "node scripts/clean.mjs"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  },
  "description": "A lightweight collection of physics-driven browser toys, presented as a retro toy catalogue.",
  "main": "index.js",
  "keywords": [],
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bkmashiro/web-toybox.git"
  },
  "bugs": {
    "url": "https://github.com/bkmashiro/web-toybox/issues"
  },
  "homepage": "https://github.com/bkmashiro/web-toybox#readme"
}
