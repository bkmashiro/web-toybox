{
  "name": "web-toybox-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev": "vite --config apps/toybox/vite.config.js",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "build:kendama": "vite build --config packages/kendama/vite.config.js && tsc -p packages/kendama/tsconfig.build.json",
    "build:site": "vite build --config apps/toybox/vite.config.js",
    "build": "pnpm build:kendama && pnpm build:site",
    "size": "node scripts/size-check.mjs",
    "clean": "node scripts/clean.mjs"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  },
  "description": "A lightweight collection of physics-driven browser toys, presented as a retro toy catalogue.",
  "main": "index.js",
  "keywords": []
}
