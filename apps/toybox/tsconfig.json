{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@web-toybox/kendama": ["../../packages/kendama/src/index.ts"],
      "@web-toybox/jacobs-ladder": ["../../packages/jacobs-ladder/src/index.ts"],
      "@web-toybox/yoyo": ["../../packages/yoyo/src/index.ts"]
    }
  },
  "include": ["src", "toys/**/*.ts", "../../packages/kendama/src", "../../packages/jacobs-ladder/src", "../../packages/yoyo/src"]
}
