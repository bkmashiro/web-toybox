{
  "name": "@web-toybox/toy-audio",
  "version": "0.0.1",
  "description": "Zero-dependency configuration-driven procedural Web Audio for browser toys.",
  "type": "module",
  "main": "./dist/toy-audio.umd.cjs",
  "module": "./dist/toy-audio.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/toy-audio.js",
      "require": "./dist/toy-audio.umd.cjs"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "vite build --config vite.config.js && tsc -b tsconfig.build.json --force",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pack:check": "pnpm pack --dry-run"
  },
  "sideEffects": false,
  "dependencies": {},
  "engines": { "node": ">=18" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bkmashiro/web-toybox.git",
    "directory": "packages/toy-audio"
  },
  "publishConfig": { "access": "public", "provenance": true }
}
