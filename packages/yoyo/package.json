  "description": "A dependency-free, physics-driven yo-yo Web Component.",
  "repository": { "type": "git", "url": "git+https://github.com/bkmashiro/web-toybox.git", "directory": "packages/yoyo" },
  "homepage": "https://bkmashiro.github.io/web-toybox/toys/yoyo/",
