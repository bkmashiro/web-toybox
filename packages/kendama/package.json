  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/kendama.js",
      "require": "./dist/kendama.umd.cjs"
    }
  },
  "dependencies": {},
  "publishConfig": { "access": "public" }
